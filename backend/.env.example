# =============================================================================
# AMMAN REAL ESTATE – Environment Configuration Template (Placeholders Only)
# Do NOT commit actual secrets or production credentials to version control.
# =============================================================================

# Server Port & Active Profile
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration (Used when running in 'prod' profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=amman_real_estate
DB_USERNAME=postgres
DB_PASSWORD=your_secure_postgresql_password_here

# JWT Authentication (Milestone 1)
JWT_SECRET=your_32_character_minimum_random_secret_key_here
JWT_EXPIRATION_SECONDS=900

# Cloudflare R2 Object Storage (Milestone 4)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=amman-real-estate-properties
R2_PUBLIC_DOMAIN=https://cdn.ammanrealestate.com

# CORS Configuration (Allowed Client Domains)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
